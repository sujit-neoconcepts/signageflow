{
    "name": "signageflow/hrms",
    "description": "Full-stack HRMS (Core, Attendance, Leave, Payroll, Compliance) package for SignageFlow",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "inertiajs/inertia-laravel": "^2.0",
        "phpoffice/phpspreadsheet": "^4.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "SignageFlow\\Hrms\\": "src/",
            "SignageFlow\\Hrms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SignageFlow\\Hrms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SignageFlow\\Hrms\\HrmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
